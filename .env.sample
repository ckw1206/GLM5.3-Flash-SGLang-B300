# Optional per-run overrides for start.sh.
#
# cp .env.sample .env   (the real .env is not tracked by git).
# Precedence: shell env > ./.env > start.sh defaults.

# GPUs to use: 8 -> TP8 (default), 4 -> TP4. Other counts are rejected.
GPU_ID=0,1,2,3,4,5,6,7

# API bind address and port.
HOST=0.0.0.0
PORT=8000

# SGLang image (needs >= v0.5.20; CUDA 13 build for B300).
IMAGE=lmsysorg/sglang:v0.5.22-cu130

# Fraction of GPU memory for weights + KV cache.
MEM_FRACTION=0.85

# MTP speculative decoding via the model's built-in head (0 = off, 1 = on).
MTP=1

# HuggingFace cache on the host (~330GB for this model).
# HF_CACHE=/data/huggingface

# Optional; GLM-5.3-Flash is public, a token only raises Hub rate limits.
# HF_TOKEN=

# Extra SGLang flags, appended last (override anything above).
# EXTRA_ARGS=--context-length 262144
